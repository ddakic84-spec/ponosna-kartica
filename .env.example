# Примјер подешавања. Праве вриједности иду у .env.local (локално) и у
# Vercel → Project → Settings → Environment Variables (на хостингу).
# Овај фајл НЕ садржи тајне и служи само као подсјетник који кључеви требају.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Админ пријава ---
ADMIN_EMAIL=
ADMIN_LOZINKA=
ADMIN_SESSION_SECRET=

# --- „Нисам робот" (Cloudflare Turnstile) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
